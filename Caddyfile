# Apex domain redirects to www — Caddy issues/renews TLS for both
# automatically via Let's Encrypt as long as DNS for both points here.
roboticsclubsrmcem.in {
	redir https://www.roboticsclubsrmcem.in{uri} permanent
}

www.roboticsclubsrmcem.in {
	encode gzip zstd
	reverse_proxy localhost:5173
}

cms.roboticsclubsrmcem.in {
	encode gzip zstd
	reverse_proxy localhost:1337
}
