    "role": {
      "type": "string"
    },
    "department": {
      "type": "string"
    },
    "branch": {
      "type": "string"
    },
    "batch": {
      "type": "string"
    },
    "isAlumni": {
      "type": "boolean",
      "default": false
    },
    "photo": {
      "type": "media",
      "multiple": false,
      "allowedTypes": ["images"]
    },
    "linkedin": {
      "type": "string"
    },
    "github": {
      "type": "string"
    },
    "instagram": {
      "type": "string"
    },
    "email": {
      "type": "string"
    },
    "bio": {
      "type": "text"
    },
    "sortOrder": {
      "type": "integer",
      "default": 0
